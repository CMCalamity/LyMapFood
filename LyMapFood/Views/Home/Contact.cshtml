@{
    ViewData["Title"] = "Liên Hệ - Lý Mập Food";
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800;900&display=swap" rel="stylesheet">

<div class="min-h-screen bg-[#FFFBF2] text-[#2D2A26] font-['Plus_Jakarta_Sans'] pb-20">

    <!-- HEADER -->
    <header class="bg-[#FFFBF2] border-b-2 border-[#2D2A26] sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
            <a href="/Home/Index" class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-[#E0533C] text-white font-black text-xl flex items-center justify-center border-2 border-[#2D2A26] shadow-[2px_2px_0px_0px_#2D2A26]">LM</div>
                <span class="font-black text-xl text-[#2D2A26]">LÝ MẬP <span class="text-[#E0533C]">FOOD</span></span>
            </a>
            <nav class="hidden md:flex gap-6 font-bold text-sm">
                <a href="/Home/Index" class="hover:text-[#E0533C]">Trang Chủ</a>
                <a href="/Home/Menu" class="hover:text-[#E0533C]">Thực Đơn & Mix Calo</a>
                <a href="/Home/Contact" class="text-[#E0533C]">Liên Hệ</a>
            </nav>
        </div>
    </header>

    <!-- SECTION LIÊN HỆ & FORM THÔNG TIN (STITCH FORM) -->
    <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid lg:grid-cols-2 gap-10 items-start">

            <!-- Form Gửi Phản Hồi -->
            <div class="bg-white p-6 sm:p-8 rounded-3xl border-2 border-[#2D2A26] shadow-[6px_6px_0px_0px_#2D2A26] space-y-4">
                <h2 class="text-2xl font-black text-[#2D2A26]">GỬI GÓP Ý & ĐẶT HÀNG SỐ LƯỢNG LỚN</h2>
                <p class="text-xs font-semibold text-[#2D2A26]/70">Bạn cần tư vấn đặt sữa cho sự kiện, văn phòng hoặc góp ý dịch vụ? Nhập thông tin bên dưới nhé!</p>

                <form class="space-y-4 pt-2">
                    <div>
                        <label class="block text-xs font-black mb-1">HỌ VÀ TÊN:</label>
                        <input type="text" placeholder="Nhập họ tên của bạn" class="w-full bg-[#FFFBF2] p-3 rounded-xl border-2 border-[#2D2A26] text-xs font-semibold focus:outline-none focus:border-[#E0533C]" />
                    </div>
                    <div>
                        <label class="block text-xs font-black mb-1">SỐ ĐIỆN THOẠI / ZALO:</label>
                        <input type="text" placeholder="Nhập số điện thoại" class="w-full bg-[#FFFBF2] p-3 rounded-xl border-2 border-[#2D2A26] text-xs font-semibold focus:outline-none focus:border-[#E0533C]" />
                    </div>
                    <div>
                        <label class="block text-xs font-black mb-1">NỘI DUNG LƯU Ý:</label>
                        <textarea rows="3" placeholder="Nhập yêu cầu của bạn..." class="w-full bg-[#FFFBF2] p-3 rounded-xl border-2 border-[#2D2A26] text-xs font-semibold focus:outline-none focus:border-[#E0533C]"></textarea>
                    </div>
                    <button type="button" class="w-full bg-[#E0533C] text-white font-black py-3.5 rounded-xl border-2 border-[#2D2A26] shadow-[3px_3px_0px_0px_#2D2A26]">GỬI THÔNG TIN</button>
                </form>
            </div>

            <!-- Thông Tin Quán & Bản Đồ -->
            <div class="space-y-6">
                <div class="bg-[#F3EAD8] p-6 rounded-3xl border-2 border-[#2D2A26] shadow-[4px_4px_0px_0px_#2D2A26] space-y-3">
                    <h3 class="font-black text-lg text-[#2D2A26]">CỬA HÀNG LÝ MẬP FOOD</h3>
                    <p class="text-xs font-bold text-[#2D2A26]/80">📍 Địa chỉ: Biên Hòa, Tỉnh Đồng Nai</p>
                    <p class="text-xs font-bold text-[#2D2A26]/80">⏰ Giờ mở cửa: 06:00 - 21:00 (Hằng ngày)</p>
                    <p class="text-xs font-bold text-[#2D2A26]/80">📞 Hotline / Zalo: 090x xxx xxx</p>
                </div>

                <div class="bg-white border-2 border-[#2D2A26] rounded-3xl h-64 flex flex-col items-center justify-center text-center p-4 shadow-[4px_4px_0px_0px_#2D2A26]">
                    <i data-lucide="map-pin" class="w-10 h-10 text-[#E0533C] mb-2"></i>
                    <span class="font-black text-sm">Bản Đồ Google Maps Biên Hòa</span>
                </div>
            </div>

        </div>
    </section>
</div>