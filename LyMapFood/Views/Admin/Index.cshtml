@model IEnumerable<LyMapFood.Models.Product>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Quản Trị Hệ Thống - Lý Mập Food</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-100 font-['Plus_Jakarta_Sans'] text-slate-800">

    <div class="flex min-h-screen">
        <!-- Sidebar Admin -->
        <aside class="w-64 bg-[#2D2A26] text-white p-6 space-y-6 flex flex-col justify-between shrink-0">
            <div class="space-y-6">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-[#E0533C] text-white font-black text-xl flex items-center justify-center">LM</div>
                    <span class="font-black text-lg">LÝ MẬP ADMIN</span>
                </div>

                <nav class="space-y-2 text-sm font-bold">
                    <a href="/Admin/Index" class="flex items-center gap-3 bg-[#E0533C] text-white p-3 rounded-xl">
                        <i data-lucide="package" class="w-5 h-5"></i>
                        <span>Quản Lý Sản Phẩm</span>
                    </a>
                    <a href="/Admin/Orders" class="flex items-center gap-3 hover:bg-slate-800 p-3 rounded-xl transition">
                        <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                        <span>Quản Lý Đơn Hàng</span>
                    </a>
                    <a href="/Home/Index" target="_blank" class="flex items-center gap-3 hover:bg-slate-800 p-3 rounded-xl transition text-amber-400">
                        <i data-lucide="external-link" class="w-5 h-5"></i>
                        <span>Xem Trang Khách</span>
                    </a>
                </nav>
            </div>

            <div class="text-xs text-slate-400">
                Logged in as: <strong>Admin Lý Mập</strong>
            </div>
        </aside>

        <!-- Main Content Admin -->
        <main class="flex-1 p-8 space-y-6">
            
            <!-- Top Dashboard Bar -->
            <div class="flex justify-between items-center bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                <div>
                    <h1 class="text-2xl font-black text-slate-900">QUẢN LÝ THỰC ĐƠN SẢN PHẨM</h1>
                    <p class="text-xs font-semibold text-slate-500 mt-1">Chỉnh sửa giá, cập nhật trạng thái món và thông tin calo cho cửa hàng</p>
                </div>

                <a href="/Admin/Create" class="bg-[#E0533C] hover:bg-[#c9432b] text-white font-black px-5 py-2.5 rounded-xl border-2 border-[#2D2A26] shadow-[2px_2px_0px_0px_#2D2A26] flex items-center gap-2 text-xs">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    <span>THÊM MÓN MỚI</span>
                </a>
            </div>

            <!-- Bảng Danh Sách Món Ăn -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-black text-slate-600 uppercase">
                            <th class="p-4">Hình Ảnh</th>
                            <th class="p-4">Tên Sản Phẩm</th>
                            <th class="p-4">Giá Bán</th>
                            <th class="p-4">Năng Lượng</th>
                            <th class="p-4">Trạng Thái</th>
                            <th class="p-4 text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm font-semibold">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="p-4">
                                    <img src="@item.ImageUrl" class="w-12 h-12 rounded-xl object-cover border border-slate-200" />
                                </td>
                                <td class="p-4 font-black text-slate-900">@item.Name</td>
                                <td class="p-4 text-[#E0533C] font-black">@item.Price.ToString("N0") đ</td>
                                <td class="p-4"><span class="bg-amber-100 text-amber-800 text-xs px-2.5 py-1 rounded-full font-bold">~@item.Calo kcal</span></td>
                                <td class="p-4">
                                    @if (item.IsAvailable)
                                    {
                                        <span class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-1 rounded-full font-bold">Đang Bán</span>
                                    }
                                    else
                                    {
                                        <span class="bg-slate-200 text-slate-600 text-xs px-2.5 py-1 rounded-full font-bold">Hết Hàng</span>
                                    }
                                </td>
                                <td class="p-4 text-center space-x-2">
                                    <a href="/Admin/Edit/@item.Id" class="bg-slate-100 hover:bg-slate-200 text-slate-800 px-3 py-1.5 rounded-lg text-xs font-bold border">Sửa</a>
                                    <button class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-lg text-xs font-bold border border-red-200">Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </main>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>